# ==========================================
# GuGa-Nexus Root GitIgnore
# ==========================================

# --- Android / App Projects ---
# Standard Android build artifacts (covers app-stable/ app-dev/)
**/build/
**/out/
**/captures/
**/*.iml
.gradle/
.externalNativeBuild/
.cxx/
local.properties
captures/
*.apk
*.aab

# --- Python / GuGa Server ---
# Global Python artifacts
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/*.egg-info/
**/*.egg
.installed.cfg
*.manifest
*.spec

# Virtual Environments
venv/
ENV/
env/
.venv/
test-env/
.python-version

# Server Secrets & Config
/server/.env
/server/trusted_devices.json
.env

# Server Logs & Runtime Data
/server/log/
/server/log
/server/alerter.log
/server/raw_dbus.log
/server/server.log
/server/nohup.out
/server/*.out
**/*.log

# Server Binaries
/server/cloudflared
/server/cloudflared.exe

# --- Tooling & IDE ---
.idea/
**/.idea/
.vscode/
**/.vscode/
.obsidian/
**/.obsidian/
.DS_Store
Thumbs.db
*.bak
*.swp
*~
*.patch
*.diff

# --- Testing ---
.pytest_cache/
.tox/
.coverage
htmlcov/
**/.pytest_cache/
nosetests.xml
coverage.xml
*.cover
.hypothesis/

# --- Databases ---
*.db
*.sqlite
*.sqlite3

# --- Artifacts & Distributions ---
dist/
target/
# --- Project Notes ---
Guga/

.agents/
scratch/

