<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Main Content Layer -->
    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        android:animateLayoutChanges="true">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GuGa"
            android:textSize="32sp"
            android:fontFamily="sans-serif-light"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="32dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chatRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="16dp"
            android:clipToPadding="false"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:id="@+id/replyPreviewContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/reply_preview_bg"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_marginHorizontal="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                    <TextView
                        android:id="@+id/replyTitleText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                <TextView
                    android:id="@+id/replyContentText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:maxLines="2"
                    android:ellipsize="end" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/cancelReplyButton"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/white" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/inputContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/input_background"
            android:padding="4dp"
            android:gravity="center_vertical"
            android:animateLayoutChanges="true">

            <Button
                android:id="@+id/bypassToggleButton"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="~"
                android:textColor="@color/gray"
                android:textSize="20sp"
                style="?android:attr/borderlessButtonStyle"
                android:padding="0dp" />

            <EditText
                android:id="@+id/manualCommandInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Type here..."
                android:textColor="@color/white"
                android:textColorHint="#444444"
                android:background="@null"
                android:padding="14dp"
                android:imeOptions="actionSend"
                android:inputType="textLongMessage" />

            <Button
                android:id="@+id/sendManualCommandButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SEND"
                android:textColor="@color/black"
                android:backgroundTint="@color/white"
                android:textStyle="bold"
                style="?android:attr/borderlessButtonStyle" />
        </LinearLayout>
    </LinearLayout>

    <!-- Connection Warning Overlay -->
    <LinearLayout
        android:id="@+id/connectionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GUGA"
            android:textColor="@color/white"
            android:textSize="48sp"
            android:letterSpacing="0.2"
            android:fontFamily="sans-serif-thin"
            android:gravity="center"
            android:layout_marginBottom="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connect to GuGu"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:fontFamily="sans-serif-light"
            android:gravity="center"
            android:layout_marginBottom="12dp" />
            
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configure IP in settings"
            android:textColor="#444444"
            android:textSize="12sp"
            android:gravity="center" />
    </LinearLayout>

    <!-- Settings Overlay -->
    <ScrollView
        android:id="@+id/settingsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Settings"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:fontFamily="sans-serif-light"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="40dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IP CONFIGURATION"
                android:textColor="#444444"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/input_background"
                android:padding="4dp"
                android:layout_marginBottom="24dp">

                <EditText
                    android:id="@+id/ipInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="0.0.0.0"
                    android:textColor="@color/white"
                    android:textColorHint="#333333"
                    android:background="@null"
                    android:padding="12dp"
                    android:inputType="textUri" />

                <Button
                    android:id="@+id/saveIpButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SAVE"
                    style="?android:attr/borderlessButtonStyle"
                    android:textColor="@color/white"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="40dp">

                <Button
                    android:id="@+id/scanQrButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="SCAN QR"
                    android:backgroundTint="@color/white"
                    android:textColor="@color/black"
                    android:textAllCaps="false"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/pingButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TEST PING"
                    android:backgroundTint="#111111"
                    android:textColor="@color/white"
                    android:textAllCaps="false" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1A1A1A"
                android:layout_marginBottom="32dp" />

            <Button
                android:id="@+id/openAdvancedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ADVANCED OPTIONS"
                android:backgroundTint="#111111"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/connectSocketButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LIVE PERSISTENCE"
                android:backgroundTint="#000000"
                android:textColor="@color/white"
                app:strokeColor="#222222"
                app:strokeWidth="1dp"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium" />


            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="STATUS: DISCONNECTED"
                android:textColor="#333333"
                android:textSize="10sp"
                android:letterSpacing="0.05"
                android:gravity="center"
                android:layout_marginTop="32dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Side Toggle Button -->
    <Button
        android:id="@+id/toggleSettingsButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:text=">"
        android:textSize="20sp"
        android:fontFamily="sans-serif-light"
        android:textColor="@color/white"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_margin="12dp" />

    <!-- Selection Mode Header -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/selectionModeHeader"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/black"
        android:elevation="4dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/selectionCountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 Selected"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageButton
            android:id="@+id/cancelSelectionButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Cancel Selection"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="@color/white" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Selection Mode Footer -->
    <LinearLayout
        android:id="@+id/selectionModeFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#111111"
        android:padding="8dp"
        android:gravity="center"
        android:visibility="gone"
        android:animateLayoutChanges="true"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/deleteSelectionButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@color/white" />

        <ImageButton
            android:id="@+id/copySelectionButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_share"
            app:tint="@color/white" />

        <ImageButton
            android:id="@+id/replySelectionButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_send"
            app:tint="@color/white" />

    </LinearLayout>

    <!-- Advanced Settings Overlay -->
    <ScrollView
        android:id="@+id/advancedSettingsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:animateLayoutChanges="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Advanced"
                android:textColor="@color/white"
                android:textSize="32sp"
                android:fontFamily="sans-serif-light"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="40dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/ttsToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TEXT TO SPEECH"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-medium"
                android:textSize="14sp"
                android:layout_marginBottom="24dp"
                app:thumbTint="@color/white"
                app:trackTint="#333333" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/hideReplyToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HIDE REPLY FIELD"
                android:textColor="@color/white"
                android:fontFamily="sans-serif-medium"
                android:textSize="14sp"
                android:layout_marginBottom="32dp"
                app:thumbTint="@color/white"
                app:trackTint="#333333" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1A1A1A"
                android:layout_marginBottom="32dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FILTERING"
                android:textColor="#444444"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/input_background"
                android:padding="4dp"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/filterInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Regex (e.g. .*Status.*)"
                    android:textColor="@color/white"
                    android:textColorHint="#333333"
                    android:background="@null"
                    android:padding="12dp"
                    android:inputType="textNoSuggestions" />

                <Button
                    android:id="@+id/applyFilterButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="APPLY"
                    style="?android:attr/borderlessButtonStyle"
                    android:textColor="@color/white"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Filtering applies to titles. Empty field shows all."
                android:textColor="#333333"
                android:textSize="10sp"
                android:layout_marginBottom="32dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1A1A1A"
                android:layout_marginBottom="32dp" />

            <Button
                android:id="@+id/searchChatsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SEARCH CHATS"
                android:backgroundTint="#111111"
                android:textColor="@color/white"
                android:textAllCaps="false"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/clearHistoryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CLEAR ALL HISTORY"
                android:backgroundTint="#1a1a1a"
                android:textColor="#fff"
                android:textAllCaps="false"
                android:layout_marginBottom="40dp" />

            <Button
                android:id="@+id/closeAdvancedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BACK TO SETTINGS"
                android:backgroundTint="#000000"
                android:textColor="@color/white"
                app:strokeColor="#222222"
                app:strokeWidth="1dp"
                android:textAllCaps="false" />

        </LinearLayout>
    </ScrollView>

    <!-- Search Overlay -->
    <LinearLayout
        android:id="@+id/searchOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Search"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:fontFamily="sans-serif-light"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/input_background"
            android:padding="4dp"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/chatSearchInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Search messages..."
                android:textColor="@color/white"
                android:textColorHint="#333333"
                android:background="@null"
                android:padding="12dp"
                android:inputType="text" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/searchRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/closeSearchButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BACK"
            android:backgroundTint="#000000"
            android:textColor="@color/white"
            app:strokeColor="#222222"
            app:strokeWidth="1dp"
            android:textAllCaps="false"
            android:layout_marginTop="16dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
