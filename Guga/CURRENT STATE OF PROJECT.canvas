		{"id":"3e1dbf2365d84abc","type":"file","file":"Excalidraw/Drawing 2026-04-22 19.42.21.excalidraw.md","x":-1720,"y":-1296,"width":303,"height":279,"color":"6"},
		{"id":"0d65b2daa0534ed3","type":"text","text":"**/clients**\nList all the clients and total number of clients","x":-1285,"y":-926,"width":250,"height":99},
		{"id":"cb07f56d79f1ef29","type":"text","text":"./deamon.py\nThis is the flask server. This is responsible for accepting notifications and sending them to clients","x":-1345,"y":-1280,"width":480,"height":104},
		{"id":"786ccf3b5ed31e8b","type":"text","text":"**/api/hello**\nEvery new client send a 8 digit pin here and is added to pending pairing queue.","x":-1285,"y":-540,"width":250,"height":131},
		{"id":"c58c86239ab76f2d","type":"text","text":"**/api/pending**\nOnly for localhost.\nThis route is responsible for check which devices are still pending to be approved.","x":-1029,"y":-540,"width":250,"height":160},
		{"id":"c4254f8575ec6c58","type":"text","text":"**/api/approve**\nOnly for localhost.\nit is used to approve or reject a device from the pending pairing queue.","x":-779,"y":-540,"width":250,"height":183},
		{"id":"f5efe59b4629852d","type":"text","text":"**/api/verify_pin**\nclient has to send the pin it gave on hello so that it can be verified as the correct device.","x":-1285,"y":-409,"width":280,"height":119},
		{"id":"a9d65f0260920203","type":"text","text":"**/**\nThis is for browser clients","x":-1285,"y":-1156,"width":250,"height":60},
		{"id":"33a2c5ad60016271","type":"text","text":"**/ping**\nTell if the server is live and how many are connected","x":-1285,"y":-1066,"width":250,"height":100},
		{"id":"cff1e2de73ea1229","type":"text","text":"**/send**\nSends a message to all the connected clients , \nonly things on the localhost can use this,\n","x":-1285,"y":-781,"width":360,"height":101},
		{"id":"f163eb2404fb36c3","type":"text","text":"**/send/<session_id>**\nSends a message to a specific connected client","x":-1260,"y":-680,"width":380,"height":80},
		{"id":"1941465340dd0562","type":"text","text":"**/api/command**\nClient can send commands it wants to be executed in here","x":-1285,"y":-290,"width":256,"height":114},
		{"id":"d675ee82b4b801fa","type":"text","text":"**./cli.py**\nThis is the cli tool , all the arguements are used using this. guga is just cli.py's alais","x":-220,"y":-1300,"width":358,"height":102},
		{"id":"a030c405367d0aac","type":"text","text":"**./alerter.py**\nSends laptop's notifications (all system generated) to the the deamon.py's flask server","x":380,"y":-1300,"width":280,"height":140},
		{"id":"6cc59812c07f1b46","type":"text","text":"**./installer.py**\nChecks the environment  , checks the config files and install a background process for guga","x":763,"y":-1308,"width":357,"height":148},
		{"id":"a12930032f9bdc34","type":"text","text":"**../pyproject.toml**\nThis file defines the guga and is used for it to be shown in pypi","x":-260,"y":-526,"width":406,"height":139},
		{"id":"3fe83b2192aeee22","type":"text","text":"**../setup.py**\nThis is used for the setup engine which installs this module","x":-235,"y":-387,"width":440,"height":104},
		{"id":"6bd211f277080630","type":"text","text":"**../MANIFEST.in**\nThis defines which files and folder to be included while installation","x":-235,"y":-283,"width":349,"height":107}
